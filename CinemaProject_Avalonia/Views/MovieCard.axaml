<UserControl
xmlns="https://github.com/avaloniaui"
xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
xmlns:dto="using:Cinema.Dto"
xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
xmlns:vm="using:CinemaProject_Avalonia.ViewModels"
mc:Ignorable="d"
d:DesignWidth="800"
d:DesignHeight="450"
x:DataType="vm:ScreeningsViewModel"
x:Class="CinemaProject_Avalonia.Views.MovieCard">
	<Border CornerRadius="10" Padding="10" Margin="6" Background="White" BoxShadow="0 2 6 #40000000">

		<Grid ColumnDefinitions="90,*">

			<!-- ===== POSTER ===== -->
			<Border Grid.Column="0" Width="80" Height="110" Background="#DDDDDD" CornerRadius="6">

				<Image Source="{Binding MovieImage}" Stretch="UniformToFill"/>
			</Border>

			<!-- ===== INFO ===== -->
			<StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="4">

				<TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold" TextWrapping="Wrap"/>

				<TextBlock Text="{Binding Room, StringFormat='Terem: {0}'}" FontSize="12" Foreground="Gray"/>

				<!-- Vetítési időpontok -->
				<ItemsControl ItemsSource="{Binding ShowTimes}">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Background="#EEEEEE" CornerRadius="4" Padding="4" Margin="2">
								<TextBlock Text="{Binding StringFormat='{}{0:MM.dd}'}" FontSize="11"/>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
					<Button Content="✏️ Szerkeszt" Command="{Binding OpenEditPanelCommand}"/>
					<Button Content="🗑 Törlés" Background="Red" Foreground="White" Command="{Binding DeleteCommand}"/>
				</StackPanel>

			</StackPanel>
		</Grid>
	</Border>
</UserControl>
