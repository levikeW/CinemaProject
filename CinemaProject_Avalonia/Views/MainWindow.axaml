<Window xmlns="https://github.com/avaloniaui"
		xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
		xmlns:vm="using:CinemaProject_Avalonia.ViewModels"
		xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
		xmlns:local="using:CinemaProject_Avalonia.Views"
		xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
		xmlns:views="using:CinemaProject_Avalonia"
		xmlns:visualbasic="using:Microsoft.VisualBasic"
		mc:Ignorable="d" d:DesignWidth="360" d:DesignHeight="740"
		x:Class="CinemaProject_Avalonia.Views.MainWindow"
		x:DataType="vm:MainWindowViewModel"
		Icon="/Assets/avalonia-logo.ico"
		Title="CinemaProject_Avalonia"
		Width="360"
		Height="740"
		MinWidth="360"
		MinHeight="740">

	<Design.DataContext>
		<!-- This only sets the DataContext for the previewer in an IDE,
		to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
		<vm:MainWindowViewModel/>
	</Design.DataContext>

	<Grid Background="LightBlue">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<Grid Grid.Row="0" Height="50" Background="#333">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<!-- ================= HEADER ================= -->
			<TextBlock Grid.Column="0" Text="Cinemánia" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="5"/>

			<Button Content="☰" Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12" Background="GhostWhite" Command="{Binding ToggleMenuCommand}"/>
		</Grid>

		<!-- ================= ERROR MESSAGE ================= -->
		<TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding HasError}"/>

		<!-- ================= FILTERS ================= -->
		<StackPanel Grid.Row="2" Margin="10" Spacing="3">
			<Label Content="🔍 Keresés: " FontSize="14"/>
			<TextBox Text="{Binding SearchText, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0 0 10 0" Background="WhiteSmoke"/>

			<Label Content=" Termek:" FontSize="13"/>
			<ComboBox ItemsSource="{Binding Rooms}" SelectedItem="{Binding SelectedRoom}" PlaceholderText="Terem" Background="WhiteSmoke" HorizontalAlignment="Stretch"/>

			<Label Content=" Filmek:" FontSize="13"/>
			<ComboBox ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedMovie}" PlaceholderText="Film" Background="WhiteSmoke" HorizontalAlignment="Stretch">
				<ComboBox.ItemTemplate>
					<DataTemplate>
						<TextBlock Text="{Binding MovieTitle}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>

			<CheckBox Content="Szűrés dátumra" IsChecked="{Binding IsDateFilterActive}"/>
			<DatePicker SelectedDate="{Binding SelectedDate}" IsEnabled="{Binding IsDateFilterActive}" Background="WhiteSmoke" HorizontalAlignment="Stretch"/>

			<Button Content="Szűrések törlése" Command="{Binding ClearFiltersCommand}" Width="140" HorizontalAlignment="Right" Background="WhiteSmoke"/>
		</StackPanel>

		<!-- ================= CONTENT ================= -->
		<ScrollViewer Grid.Row="3" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
			<ItemsControl ItemsSource="{Binding FilteredScreenings}">
				<ItemsControl.ItemTemplate>
					<DataTemplate>
						<local:MovieCard DataContext="{Binding}"/>
					</DataTemplate>
				</ItemsControl.ItemTemplate>
			</ItemsControl>
		</ScrollViewer>



		<!-- ================= MENU (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="#AA000000"	ZIndex="50"	IsVisible="{Binding IsMenuOpen}" PointerPressed="Overlay_PointerPressed">

			<Border Width="240"
					Background="White"
					HorizontalAlignment="Left"
					PointerPressed="Menu_PointerPressed">

				<StackPanel Margin="16" Spacing="12">
					<Button Content="Új Film létrehozása" Command="{Binding AddNewMovieCommand}"/>
					<Button Content="Új Vetítés létrehozása" Command="{Binding AddNewScreeningCommand}"/>
					<Button Content="Felhasználók" Command="{Binding OpenUsersPageCommand}"/>
					<Button Content="Jegyek" Command="{Binding OpenTicketsPageCommand}"/>
					<Button Content="Termek" Command="{Binding OpenRoomPageCommand}"/>
					<Button Content="Foglalások" Command="{Binding OpenReservationCommand}"/>
					<Button Content="Kijelentkezés" Command="{Binding Logout}"/>
				</StackPanel>
			</Border>
		</Border>

		<!-- ================= SCREENING EDITPANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="#AA000000" ZIndex="100" IsVisible="{Binding IsScreeningEditPanelOpen}" IsHitTestVisible="{Binding IsScreeningEditPanelOpen}">

			<Border Width="300"	Background="White" CornerRadius="8"	Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel Spacing="10">
					<TextBlock Text="Film szerkesztése"
							   FontSize="18"
							   FontWeight="Bold"/>

					<ComboBox ItemsSource="{Binding Movies}" SelectedItem="{Binding SelectedScreening.Title}" PlaceholderText="Film" Background="WhiteSmoke" HorizontalAlignment="Stretch">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding MovieTitle}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<ComboBox ItemsSource="{Binding Rooms}"
							  SelectedItem="{Binding SelectedScreening.Room, Mode=TwoWay, FallbackValue=''}" PlaceholderText="Terem" Background="WhiteSmoke" HorizontalAlignment="Stretch" />

					<TextBlock Text="Vetítési időpontok:" FontWeight="SemiBold"/>
					<ItemsControl ItemsSource="{Binding SelectedScreening.ShowTimes}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Grid ColumnDefinitions="*, Auto" Margin="0,2">
									<TextBlock Text="{Binding StringFormat='{}{0:yyyy.MM.dd}'}" VerticalAlignment="Center"/>

									<Button Grid.Column="1" Content="X" Command="{Binding ((vm:MainWindowViewModel)DataContext).DeleteDateSelectedMovieCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" Foreground="Red"/>
								</Grid>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
					<DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}" HorizontalAlignment="Stretch" Width="290" Margin="1"/>
					<Button Content="+ Időpont hozzáadása" Command="{Binding AddDateToSelectedMovieCommand}" HorizontalAlignment="Stretch"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">

						<Button Content="Mentés és Bezárás" Background="#C8E6C9" Width="100" Command="{Binding CloseEditPanelCommand}" />
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
		<!-- ================= MOVIE EDITPANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="#AA000000" ZIndex="100" IsVisible="{Binding IsMovieEditPanelOpen}">

			<Border Width="320" Background="White" CornerRadius="8" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">

				<StackPanel Spacing="10" DataContext="{Binding SelectedMovieEdit}">

					<TextBlock Text="Új film hozzáadása" FontSize="18" FontWeight="Bold"/>

					<TextBox Text="{Binding MovieTitle}" Watermark="Film címe" Background="WhiteSmoke"/>

					<TextBox Text="{Binding Duration}" Watermark="Hossz (perc)" Background="WhiteSmoke"/>

					<TextBox Text="{Binding Genre}" Watermark="Műfaj" Background="WhiteSmoke"/>

					<TextBox Text="{Binding Director}" Watermark="Rendező" Background="WhiteSmoke"/>

					<TextBox Text="{Binding Description}" Watermark="Leírás" AcceptsReturn="True" Height="60" Background="WhiteSmoke"/>

					<TextBox Text="{Binding ImageId}" Watermark="Image ID" Background="WhiteSmoke"/>

					<ComboBox ItemsSource="{Binding MovieStatuses}" SelectedItem="{Binding Status}">
						<ComboBox.ItemTemplate>
							<DataTemplate>
								<TextBlock Text="{Binding}" />
							</DataTemplate>
						</ComboBox.ItemTemplate>
					</ComboBox>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">

						<Button Content="Mentés" Background="#C8E6C9" Width="100" Command="{Binding SaveMovieCommand}"/>

						<Button Content="Bezárás" Background="#FFCDD2" Command="{Binding ((vm:MainWindowViewModel)DataContext).CloseMovieEditPanelCommand, RelativeSource={RelativeSource AncestorType=Border}}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
		<!-- ================= USERSPANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="White" ZIndex="200" IsVisible="{Binding IsUsersPageOpen}">
			<Grid RowDefinitions="Auto, *, Auto" Margin="20">
				<TextBlock Grid.Row="0" Text="Felhasználók" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

				<ScrollViewer Grid.Row="1">
					<ItemsControl ItemsSource="{Binding Users}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#F5F5F5" CornerRadius="10" Padding="10" Margin="0,0,0,12">
									<StackPanel Spacing="6">
										<TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
										<TextBlock Text="{Binding Email}" FontSize="13" Foreground="Gray"/>

										<StackPanel Orientation="Horizontal" Spacing="10">
											<TextBlock Text="Role:" VerticalAlignment="Center"/>
											<ComboBox Width="120" SelectedItem="{Binding Role, Mode=TwoWay}">
												<x:String>User</x:String>
												<x:String>Admin</x:String>
											</ComboBox>
										</StackPanel>

										<StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
											<Button Content="Mentés" Command="{Binding SaveUserCommand}" Background="#C8E6C9" Width="100"/>
											<Button Content="🗑 Törlés" Background="Red" Foreground="White" Command="{Binding DeleteCommand}"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
				<StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">

					<TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding HasError}"/>
					<Button Content="Vissza a főoldalra" Command="{Binding CloseUsersPageCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="LightGray"/>
				</StackPanel>
			</Grid>
		</Border>
		<!-- ================= PRICEPANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="White" ZIndex="150" IsVisible="{Binding IsTicketsPageOpen}">
			<Grid RowDefinitions="Auto, *, Auto" Margin="20">
				<TextBlock Grid.Row="0" Text="Jegyek" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>


				<ScrollViewer Grid.Row="1">
					<ItemsControl ItemsSource="{Binding Prices}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#F5F5F5" CornerRadius="8" Padding="10" Margin="0,0,0,10">
									<StackPanel Orientation="Horizontal" Spacing="15">
										<TextBox Text="{Binding Name}" Width="150" Watermark="Jegy név"/>
										<TextBox Text="{Binding Price}" Width="80" Watermark="Ár"/>

										<Button Content="Mentés" Command="{Binding SaveTicketCommand}" Background="#C8E6C9" Width="80"/>

										<Button Content="🗑 Törlés" Command="{Binding DeleteCommand}" Background="Red" Foreground="White"/>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
					<!-- <Button Content="Ticket modify/save" Command="{Binding AddPriceCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/> -->
					<TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding HasError}"/>
					<Button Content="Vissza a főoldalra" Command="{Binding CloseTicketPageCommand}"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="LightGray"/>
				</StackPanel>
			</Grid>
		</Border>
		<!-- ================= ROOMPANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="White" ZIndex="150" IsVisible="{Binding IsRoomPageOpen}">
			<Grid RowDefinitions="Auto, *, Auto" Margin="20">
				<TextBlock Grid.Row="0" Text="Termek" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>


				<ScrollViewer Grid.Row="1">
					<ItemsControl ItemsSource="{Binding Room}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<StackPanel Orientation="Horizontal" Spacing="20" Margin="0,10">
									<TextBox Text="{Binding Name}" Width="120"/>
									<Button Content="🗑 Törlés" Background="Red" Foreground="White" Command="{Binding DeleteCommand}"/>
								</StackPanel>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>

				<StackPanel Grid.Row="2" Spacing="10" Margin="0,20,0,0">
					<!-- <Button Content="+ Új terem hozzáadása" Command="{Binding AddRoomCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/> -->
					<TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding HasError}"/>
					<Button Content="Vissza a főoldalra" Command="{Binding CloseRoomPageCommand}"  HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Background="LightGray"/>
				</StackPanel>
			</Grid>
		</Border>
		<!--================= RESERVATIONS PANEL (OVERLAY) ================= -->
		<Border Grid.RowSpan="4" Background="White" ZIndex="200" IsVisible="{Binding IsReservationPageOpen}">
			<Grid RowDefinitions="Auto,*,Auto" Margin="15">
				<TextBlock Grid.Row="0" Text="Foglalások" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,15"/>
				<ScrollViewer Grid.Row="1">
					<ItemsControl ItemsSource="{Binding Reservations}">
						<ItemsControl.ItemTemplate>
							<DataTemplate>
								<Border Background="#F5F5F5" CornerRadius="10" Padding="12" Margin="0,0,0,12">
									<StackPanel Spacing="6">
										<TextBlock Text="{Binding ReservationId, StringFormat='Foglalás #{0}'}" FontWeight="Bold" FontSize="16"/>

										<TextBlock Text="{Binding Date, StringFormat='Dátum: {0}'}"/>
										<TextBlock Text="{Binding ScreeningId, StringFormat='Vetítés: {0}'}"/>
										<TextBlock Text="{Binding Amount, StringFormat='Jegyek: {0}'}"/>
										<TextBlock Text="{Binding Price, StringFormat='Ár: {0} Ft'}"/>
										<TextBlock Text="{Binding UserId, StringFormat='Felhasználó: {0}'}"/>
										<TextBlock Text="{Binding IsPaid, StringFormat='Fizetve: {0}'}"/>

										<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,10,0,0">
											<Button Content="✏️ Szerkeszt" Width="90" Command="{Binding OpenEditPanelCommand}"/>
											<Button Content="🗑 Törlés" Background="Red" Foreground="White" Command="{Binding DeleteCommand}"/>
										</StackPanel>
									</StackPanel>
								</Border>
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>
				</ScrollViewer>
				<StackPanel Grid.Row="2" Margin="0,10,0,0">
					<TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="Red" FontWeight="Bold" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="320" IsVisible="{Binding HasError}"/>
					<Button Content="Vissza a főoldalra" Command="{Binding CloseReservationPageCommand}" Background="LightGray" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
				</StackPanel>
			</Grid>
		</Border>

		<Border Background="#DDFFFFFF" ZIndex="300" IsVisible="{Binding IsReservationEditPanelOpen}">
			<Border Width="320" Padding="20" Background="White" CornerRadius="10" HorizontalAlignment="Center" VerticalAlignment="Center">
				<StackPanel Spacing="10">
					<TextBlock Text="✏️ Foglalás szerkesztése" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

					<TextBox Text="{Binding SelectedReservationItem.Date, Mode=TwoWay}"/>
					<TextBox Text="{Binding SelectedReservationItem.ScreeningId, Mode=TwoWay}"/>
					<TextBox Text="{Binding SelectedReservationItem.Amount, Mode=TwoWay}"/>
					<TextBox Text="{Binding SelectedReservationItem.Price, Mode=TwoWay}"/>
					<TextBox Text="{Binding SelectedReservationItem.UserId, Mode=TwoWay}"/>

					<CheckBox Content="Fizetve" IsChecked="{Binding SelectedReservationItem.IsPaid}"/>

					<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
						<Button Content="Mentés" Command="{Binding SelectedReservationItem.SaveReservationCommand}" Background="#C8E6C9" Width="100"/>
						<Button Content="Bezárás" Command="{Binding CloseReservationPanelCommand}"/>
					</StackPanel>
				</StackPanel>
			</Border>
		</Border>
		<!-- ================= FOOTER ================= -->
		<Border Grid.Row="4" Background="#333" Padding="10">
			<TextBlock Text="© 2025 Filmes oldal" Foreground="White" HorizontalAlignment="Center"/>
		</Border>
	</Grid>
</Window>
